aws_region          = "us-east-1"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"   # ssh-keygen -t ed25519 if you don't have one

# SSH source IP is auto-detected at plan time. Uncomment to pin it instead:
# ssh_cidr_override = "203.0.113.5/32"

server_name     = "REPLACE_ME_SERVER_NAME"
world_name      = "Midgard"
server_password = "REPLACE_ME_SERVER_PASSWORD"   # 5+ chars, can't contain server_name, no " \ $ ` characters
server_public   = true            # must be true: player counts / idle auto-stop need the Steam query port, which only works when listed

# --- Discord control (see docs/runbook.md "Discord control"). Both from the Developer Portal / Discord client.
discord_public_key = "REPLACE_ME_DISCORD_PUBLIC_KEY"   # Application > General Information > Public Key
discord_guild_id   = "REPLACE_ME_DISCORD_GUILD_ID"   # your Discord server's ID

# --- Idle auto-stop and backup retention
idle_minutes          = 30
backup_retention_days = 30
